{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run SemantiCode Backend",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["backend.main:app", "--reload", "--port", "8000"],
      "console": "integratedTerminal"
    },
    {
      "name": "Run SemantiCode Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/frontend/extension",
        "${workspaceFolder}/demo-project"
      ],
      "outFiles": ["${workspaceFolder}/frontend/extension/dist/**/*.js"],
      "preLaunchTask": "${defaultBuildTask}"
    }
  ]
}
